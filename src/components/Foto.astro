---
interface Props { src?: string; alt?: string; ratio?: string; class?: string; eager?: boolean }
const { src, alt = '', ratio = '3 / 2', class: cls, eager = false } = Astro.props;
---
{src ? (
  <div class:list={['foto', cls]} style={`aspect-ratio: ${ratio}`}>
    <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : undefined} />
  </div>
) : (
  <div class:list={['foto', 'foto-vazia', cls]} style={`aspect-ratio: ${ratio}`} aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5"><rect x="3" y="6" width="18" height="14" rx="2"></rect><circle cx="12" cy="13" r="3.5"></circle><path d="M8 6l1.5-2h5L16 6"></path></svg>
  </div>
)}
