---
import { postUrl, type Post } from '../lib/posts';
interface Props { posts: Post[]; title?: string }
const { posts, title = 'Mais recentes' } = Astro.props;
---
{posts.length > 0 && (
  <div>
    <div class="head"><h2>{title}</h2></div>
    <ol>
      {posts.map((p, i) => (
        <li><span class="n" aria-hidden="true">{i + 1}</span><a href={postUrl(p)}>{p.data.title}</a></li>
      ))}
    </ol>
  </div>
)}

<style>
  .head { border-top: 3px solid var(--tinta); padding-top: 12px; margin-bottom: 8px; }
  h2 { margin: 0; font-family: var(--serif); font-size: 24px; font-weight: 900; letter-spacing: -.02em; }
  ol { list-style: none; margin: 0; padding: 0; }
  li { display: flex; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--linha); }
  li:last-child { border-bottom: 0; }
  .n { font-family: var(--serif); font-size: 40px; font-weight: 900; line-height: .9; color: var(--caju); width: 28px; flex-shrink: 0; }
  a { font-family: var(--serif); font-size: 18px; font-weight: 700; line-height: 1.2; }
</style>
